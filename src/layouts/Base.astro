---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props { titulo: string; descripcion?: string; migas?: { txt: string; href?: string }[] }
const { titulo, descripcion = 'Actividades, lecturas y proyectos de Tópico 2.', migas = [] } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%231c1e21'/%3E%3Ctext x='16' y='21' font-family='Arial' font-size='13' font-weight='700' fill='white' text-anchor='middle'%3ET2%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-40 border-b border-linea bg-white/90 backdrop-blur" transition:persist="barra">
      <div class="contenedor flex h-14 items-center gap-4">
        <a href="/" class="flex shrink-0 items-center gap-2 text-[15px] font-semibold">
          <span class="grid size-8 place-items-center rounded-lg bg-texto text-xs font-bold text-white">T2</span>
          Tópico 2
        </a>
        <nav id="migas" class="flex min-w-0 items-center gap-1.5 overflow-x-auto whitespace-nowrap text-sm text-suave [scrollbar-width:none]"></nav>
        <span class="etiqueta ml-auto hidden md:inline-flex">UAQ · 2026</span>
      </div>
    </header>

    <template id="datos-migas" set:html={JSON.stringify(migas)}></template>

    <main class="flex-1" data-pagina>
      <slot />
    </main>

    <footer class="border-t border-linea">
      <div class="contenedor flex flex-col gap-1 py-6 text-sm text-suave sm:flex-row sm:justify-between">
        <span>Tópico 2 · 2026</span>
        <span>UAQ · Facultad de Informática</span>
      </div>
    </footer>

    <script>
      import { iniciarPagina, iniciarGlobal } from '../scripts/anim';
      iniciarGlobal();
      document.addEventListener('astro:page-load', iniciarPagina);
    </script>
  </body>
</html>
