---
import Base from '../layouts/Base.astro';
---
<Base titulo="No encontrado · Tópico 2">
  <section class="contenedor flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="etiqueta">Error 404</span>
    <h1 class="titulo mt-5 text-4xl md:text-5xl">Esta página no existe</h1>
    <p class="mt-3 text-suave">Puede que se haya movido o que el enlace esté mal escrito.</p>
    <a class="boton mt-8" href="/">Volver al inicio</a>
  </section>
</Base>
