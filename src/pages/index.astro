---
import Base from '../layouts/Base.astro';
import Flecha from '../components/Flecha.astro';
import { catalogo, iniciales, totalActividades, totalAlumnos, plural } from '../data/catalogo';

const t = catalogo.topico;
const temas = catalogo.temas || [];
const anio = new Date(catalogo.generado || Date.now()).getFullYear();
const primerGrupo = catalogo.grupos[0];
const stats: [number, string][] = [
  [totalAlumnos, 'Alumnos'],
  [totalActividades, 'Actividades'],
  [temas.length, 'Temas'],
  [catalogo.tecnologias.length, 'Tecnologías']
];
---
<Base titulo={`${t.titulo} · ${anio}`} descripcion={t.resumen}>
  <section class="contenedor pb-12 pt-16 text-center md:pt-24">
    <span class="etiqueta">{t.periodo}</span>
    <h1 class="titulo mx-auto mt-6 max-w-3xl text-5xl md:text-7xl">{t.titulo}</h1>
    <p class="mx-auto mt-5 max-w-xl text-base text-suave md:text-lg">{t.resumen}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {primerGrupo && <a class="boton" href={`/g/${primerGrupo.id}`}>Ver alumnos</a>}
      {temas.length > 0 && <a class="boton-sec" href="#temas">Explorar temas</a>}
    </div>
  </section>

  <section class="contenedor">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {stats.map(([n, txt]) => (
        <div class="tarjeta" data-lote>
          <span class="text-sm text-suave">{txt}</span>
          <b class="text-4xl font-semibold tracking-tight" data-contar={n}>{n}</b>
        </div>
      ))}
    </div>
  </section>

  <section class="contenedor pt-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="seccion">Grupos</h2>
      <span class="text-sm text-suave">{plural(catalogo.grupos.length, 'grupo', 'grupos')}</span>
    </div>
    <div class="rejilla mt-5">
      {catalogo.grupos.map(g => (
        <a class="tarjeta" href={`/g/${g.id}`} data-lote>
          <Flecha />
          <span class="text-sm text-suave">Grupo</span>
          <span class="text-4xl font-semibold tracking-tight" transition:name={`grupo-${g.id}`}>{g.id}</span>
          <p class="text-sm text-suave">{plural(g.alumnos.length, 'alumno', 'alumnos')} · {g.alumnos.reduce((n, a) => n + a.actividades.length, 0)} actividades</p>
          <div class="mt-1 flex -space-x-2">
            {g.alumnos.slice(0, 7).map(a => (
              <span class="avatar size-8 border-2 border-white text-[10px]">{iniciales(a.nombre)}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  {temas.length > 0 && (
    <section id="temas" class="contenedor scroll-mt-20 pt-16">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="seccion">Temas encontrados</h2>
          <p class="mt-1 text-sm text-suave">Detectados automáticamente a partir de las actividades del grupo.</p>
        </div>
        <span class="hidden text-sm text-suave sm:inline">{plural(temas.length, 'tema', 'temas')}</span>
      </div>
      <div class="rejilla mt-5">
        {temas.map(x => (
          <article class="tarjeta" data-lote>
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-lg font-semibold leading-snug">{x.nombre}</h3>
              <span class="etiqueta shrink-0">{x.alumnos} · {x.actividades} act.</span>
            </div>
            <p class="text-sm text-suave">{x.resumen}</p>
            <div class="mt-auto flex flex-wrap gap-1.5 pt-1">
              {x.ejemplos.map(e => (
                <a class="chip" href={`/g/${e.grupo}/${e.alumno}/${e.actividad}`} title={e.titulo}>{e.nombre.split(/\s+/)[0]}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {catalogo.tecnologias.length > 0 && (
    <section class="contenedor pb-20 pt-16">
      <h2 class="seccion">Tecnologías</h2>
      <div class="mt-5 flex flex-wrap gap-2">
        {catalogo.tecnologias.map(x => <span class="chip">{x}</span>)}
      </div>
    </section>
  )}
</Base>
